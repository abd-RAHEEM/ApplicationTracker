# ==============================================================================
# JobTracker Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values before running the app.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="ApplicationTracker"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=false
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR

# ── Server ─────────────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
# Async URL — used by FastAPI/SQLAlchemy at runtime
DATABASE_URL="postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres"
# Sync URL — used by Alembic migration scripts only
DATABASE_URL_SYNC="postgresql+psycopg://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ── Redis (Upstash or local) ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
# For Upstash TLS: "rediss://:password@host:port"

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY="CHANGE_THIS_to_a_very_long_random_hex_string_at_least_64_characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AES-256-GCM Encryption (Gmail Token Storage) ──────────────────────────────
# Generate with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Must be exactly 32 bytes (44 base64 chars).
ENCRYPTION_KEY="CHANGE_THIS_to_a_base64_encoded_32_byte_random_key=================="

# ── Google OAuth 2.0 (Phase 2 — Gmail Integration) ────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/v1/gmail/callback"

# ── SMTP (Password Reset Emails) ──────────────────────────────────────────────
# Use Gmail App Password or SendGrid SMTP relay
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-system-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM_NAME="JobTracker"
SMTP_FROM_EMAIL="noreply@jobtracker.com"
SMTP_USE_TLS=true

# ── JWT ──────────────────────────────────────────────────────────────────────
# Run `openssl rand -hex 32` to generate a secure key
JWT_SECRET_KEY="super-secret-key-that-must-be-at-least-32-chars-long"

# ── AES-256-GCM Encryption ───────────────────────────────────────────────────
# Run `openssl rand -base64 32` to generate a 32-byte key, then base64 encode it.
ENCRYPTION_KEY="replace-this-with-a-real-base64-encoded-key-that-is-at-least-44-chars-long"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/v1/gmail/callback"
OAUTH_STATE_EXPIRE_SECONDS=300

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="3/minute"
RATE_LIMIT_PASSWORD_RESET="3/minute"
RATE_LIMIT_SYNC="2/minute"

# ── Password Reset ─────────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ── Bin Cleanup ────────────────────────────────────────────────────────────────
BIN_RETENTION_DAYS=15
